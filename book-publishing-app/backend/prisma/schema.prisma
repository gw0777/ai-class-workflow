// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 사용자 역할 열거형
enum UserRole {
  ADMIN     // 시스템 관리자
  EDITOR    // 편집자
  REVIEWER  // 검토자
  VIEWER    // 열람자
}

// 교재 상태 열거형
enum TextbookStatus {
  DRAFT       // 초안
  IN_REVIEW   // 검토 중
  APPROVED    // 승인됨
  PUBLISHED   // 출판됨
  ARCHIVED    // 보관됨
}

// 출판 규정 카테고리 열거형
enum RegulationCategory {
  COPYRIGHT         // 저작권
  ISBN              // ISBN 등록
  FORMATTING        // 편집 형식
  CONTENT_STANDARD  // 콘텐츠 기준
  DISTRIBUTION      // 유통
  QUALITY           // 품질 관리
  LEGAL             // 법적 요건
}

// 워크플로우 단계 상태 열거형
enum WorkflowStepStatus {
  PENDING     // 대기 중
  IN_PROGRESS // 진행 중
  COMPLETED   // 완료
  REJECTED    // 거부됨
}

// 평가 문항 유형 열거형
enum AssessmentType {
  MULTIPLE_CHOICE  // 객관식
  TRUE_FALSE       // 참/거짓
  SHORT_ANSWER     // 단답형
  ESSAY            // 서술형
}

// 사용자 모델
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          UserRole @default(VIEWER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?

  // 관계
  textbooks     Textbook[]      @relation("EditorTextbooks")
  workflowSteps WorkflowStep[]
  comments      Comment[]
  editSessions  EditSession[]

  @@map("users")
}

// 교재 모델
model Textbook {
  id          String          @id @default(cuid())
  title       String
  subtitle    String?
  description String?         @db.Text
  isbn        String?         @unique
  author      String
  language    String          @default("ko")
  status      TextbookStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // 외래 키
  editorId    String

  // 관계
  editor      User              @relation("EditorTextbooks", fields: [editorId], references: [id])
  chapters    Chapter[]
  metadata    TextbookMetadata?
  workflow    PublishingWorkflow?
  versions    TextbookVersion[]

  @@index([status])
  @@index([editorId])
  @@map("textbooks")
}

// 교재 메타데이터
model TextbookMetadata {
  id             String   @id @default(cuid())
  subject        String
  targetAudience String
  difficulty     String
  keywords       String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 외래 키
  textbookId     String   @unique

  // 관계
  textbook       Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  @@map("textbook_metadata")
}

// 챕터 모델
model Chapter {
  id                  String   @id @default(cuid())
  number              Int
  title               String
  content             String   @db.Text
  learningObjectives  String[]
  summary             String?  @db.Text
  order               Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // 외래 키
  textbookId          String

  // 관계
  textbook            Textbook     @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  sections            Section[]
  assessments         Assessment[]

  @@index([textbookId, order])
  @@map("chapters")
}

// 섹션 모델 (챕터 내 하위 섹션)
model Section {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 외래 키
  chapterId String

  // 관계
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, order])
  @@map("sections")
}

// 평가 문항 모델
model Assessment {
  id          String          @id @default(cuid())
  question    String          @db.Text
  type        AssessmentType
  options     String[]
  answer      String
  explanation String?         @db.Text
  difficulty  Int             @default(3)
  points      Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // 외래 키
  chapterId   String

  // 관계
  chapter     Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("assessments")
}

// 출판 규정 모델
model PublishingRegulation {
  id            String              @id @default(cuid())
  title         String
  description   String?
  content       String              @db.Text
  category      RegulationCategory
  country       String
  version       String
  effectiveDate DateTime
  source        String?
  tags          String[]
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([category])
  @@index([country])
  @@index([isActive])
  @@map("publishing_regulations")
}

// 출판 워크플로우 모델
model PublishingWorkflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 외래 키
  textbookId  String   @unique

  // 관계
  textbook    Textbook        @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  steps       WorkflowStep[]

  @@map("publishing_workflows")
}

// 워크플로우 단계 모델
model WorkflowStep {
  id          String             @id @default(cuid())
  name        String
  description String?
  status      WorkflowStepStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  notes       String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // 외래 키
  workflowId  String
  assigneeId  String?

  // 관계
  workflow    PublishingWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  assignee    User?              @relation(fields: [assigneeId], references: [id])

  @@index([workflowId])
  @@index([assigneeId])
  @@map("workflow_steps")
}

// 교재 버전 모델 (스냅샷 기반 버전 관리)
model TextbookVersion {
  id          String   @id @default(cuid())
  version     String
  snapshot    Json
  createdBy   String
  createdAt   DateTime @default(now())

  // 외래 키
  textbookId  String

  // 관계
  textbook    Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  @@index([textbookId])
  @@map("textbook_versions")
}

// 편집 세션 모델 (협업 편집 추적)
model EditSession {
  id        String   @id @default(cuid())
  startedAt DateTime @default(now())
  endedAt   DateTime?

  // 외래 키
  userId    String

  // 관계
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("edit_sessions")
}

// 댓글 모델
model Comment {
  id         String   @id @default(cuid())
  content    String   @db.Text
  context    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 외래 키
  authorId   String

  // 관계
  author     User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@map("comments")
}

// 원본 자료 모델 (PDF/PPTX 변환용)
model SourceMaterial {
  id           String   @id @default(cuid())
  filename     String
  originalPath String
  fileType     String
  fileSize     Int
  uploadedAt   DateTime @default(now())
  processedAt  DateTime?
  metadata     Json?

  @@map("source_materials")
}

// 템플릿 모델 (교재 템플릿)
model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  structure   Json
  styles      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("templates")
}
