# === agent_office 환경변수 === (복사: cp .env.example .env)

# 필수
ANTHROPIC_API_KEY=sk-ant-...
OWNER_DISCORD_ID=123456789012345678        # 승인(✅/❌) 권한자 — 디스코드 개발자 모드에서 내 ID 복사

# 봇 토큰: 둘 중 하나
#  (a) 봇 계정 1개가 채널 7개를 돌봄
DISCORD_TOKEN=
#  (b) 스레드처럼 역할마다 봇 계정을 따로 둠(이름·아바타가 다름). 비워둔 역할은 DISCORD_TOKEN 으로 대체
DISCORD_TOKEN_MANAGER=
DISCORD_TOKEN_RESEARCH=
DISCORD_TOKEN_TEACHING=
DISCORD_TOKEN_SOCIETY=
DISCORD_TOKEN_CENTER=
DISCORD_TOKEN_WRITER=
DISCORD_TOKEN_SECRETARY=

# 선택
AGENTS_YAML=config/agents.yaml
OFFICE_DB=office.db
OFFICE_OUTPUT_DIR=output
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
PAPER_PIPELINE_URL=http://localhost:8000   # paper_pipeline_v2 서버
PAPER_PIPELINE_API_KEY=
APPROVAL_TIMEOUT_SEC=86400
HEARTBEAT_ENABLED=true
ENABLE_FALLBACKS=true
ALLOW_NON_OWNER=false
DRY_RUN=false                              # true 면 API 호출 없이 에코(배선 점검)
