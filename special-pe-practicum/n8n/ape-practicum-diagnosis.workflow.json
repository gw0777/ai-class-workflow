    {
      "id": "engine-002",
      "name": "Competency Engine (영역①②)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 192],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const d = $json;\nconst expMap = { \"없음\": 1, \"1-2회\": 3, \"여러 번\": 5 };\nconst expScore = expMap[d.experience] || 1;\nconst items = [Number(d.understanding)||1, Number(d.selfEfficacy)||1, Number(d.safety)||1, Number(d.communication)||1, expScore];\nconst sum = items.reduce((a,b)=>a+b,0);\nconst readinessScore = Math.round(((sum - 5) / 20) * 100);\nlet gaps = [];\nif (Number(d.understanding) <= 2) gaps.push(\"장애유형 이해 부족\");\nif (Number(d.selfEfficacy) <= 2) gaps.push(\"자기효능감 낮음\");\nif (Number(d.safety) <= 2) gaps.push(\"안전·응급 지식 부족\");\nif (Number(d.communication) <= 2) gaps.push(\"의사소통 전략 미흡\");\nif (expScore <= 1) gaps.push(\"현장 지도 경험 없음\");\nconst gapsText = gaps.length ? gaps.join(\", \") : \"주요 결손 없음\";\nconst noteMap = {\n  \"자폐성장애\": \"구조화·예측가능 루틴, 시각적 단서, 감각 고려\",\n  \"지적장애\": \"과제 단순화·단계화, 반복·구체적 피드백\",\n  \"지체장애\": \"용기구·환경 수정, 보조기구·접근성 확보\",\n  \"시각장애\": \"청각·촉각 단서, 공간 안내, 음향 신호\",\n  \"청각장애\": \"시각 신호·수어/제스처, 시범 중심 지도\"\n};\nconst disabilityNote = noteMap[d.disabilityType] || \"개별 특성 고려\";\nreturn { ...d, readinessScore, gaps, gapsText, disabilityNote };"
      }
    },
