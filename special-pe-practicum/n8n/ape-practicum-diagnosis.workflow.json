            { "fieldLabel": "지도 경험", "fieldName": "experience", "fieldType": "dropdown", "fieldOptions": { "values": [{ "option": "없음" }, { "option": "1-2회" }, { "option": "여러 번" }] }, "requiredField": true },
            { "fieldLabel": "지도 자기효능감 (1=낮음 ~ 5=높음)", "fieldName": "selfEfficacy", "fieldType": "number", "requiredField": true },
            { "fieldLabel": "안전·응급 지식 (1=낮음 ~ 5=높음)", "fieldName": "safety", "fieldType": "number", "requiredField": true },
            { "fieldLabel": "의사소통 전략 숙지 (1=낮음 ~ 5=높음)", "fieldName": "communication", "fieldType": "number", "requiredField": true },
            { "fieldLabel": "담당 학습자 주 장애유형", "fieldName": "disabilityType", "fieldType": "dropdown", "fieldOptions": { "values": [{ "option": "자폐성장애" }, { "option": "지적장애" }, { "option": "지체장애" }, { "option": "시각장애" }, { "option": "청각장애" }] }, "requiredField": true },
            { "fieldLabel": "수업 활동 유형", "fieldName": "activityType", "fieldType": "dropdown", "fieldOptions": { "values": [{ "option": "기초운동/이동" }, { "option": "구기/게임" }, { "option": "수영/수중" }, { "option": "표현/리듬" }] }, "requiredField": true }
          ]
