# === 논문생산 무인 파이프라인 v2 환경변수 ===
# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요.
#   cp .env.example .env

# 필수: API 키
GEMINI_API_KEY=your-gemini-api-key-here
CLAUDE_API_KEY=your-anthropic-api-key-here

# 선택: 모델 (기본값 사용 권장)
CLAUDE_MODEL=claude-opus-4-8
GEMINI_MODEL=gemini-2.5-flash

# 선택: Claude 추론 강도 (low | medium | high | xhigh | max)
CLAUDE_EFFORT=high

# 선택: 결과 저장 폴더
OUTPUT_DIR=output

# 선택: 타임아웃(초)
GEMINI_TIMEOUT=120
CLAUDE_TIMEOUT=600

# 선택: 서버 호스트/포트
HOST=0.0.0.0
PORT=8000
