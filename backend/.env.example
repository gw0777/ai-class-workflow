# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database - PostgreSQL (구조화 메타데이터)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=policy_analysis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# Database - MongoDB (비구조화 문서)
MONGODB_URI=mongodb://localhost:27017/policy_documents
MONGODB_DB_NAME=policy_documents

# Vector Database - Qdrant (의미 기반 검색)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=policy_embeddings

# Claude API Configuration
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL_HAIKU=claude-3-haiku-20240307
CLAUDE_MODEL_SONNET=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# Embedding Model Configuration
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIMENSION=1024
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Redis Configuration (캐싱 및 작업 큐)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Crawler Configuration
CRAWLER_USER_AGENT=Universal-Policy-Analysis-Bot/1.0
CRAWLER_DELAY_MS=1000
CRAWLER_MAX_CONCURRENT=5
CRAWLER_TIMEOUT_MS=30000

# NLP Configuration
NLP_LANGUAGE=ko
NLP_STOPWORDS_PATH=./config/stopwords/korean.txt
NLP_DOMAIN_DICT_PATH=./config/dictionaries

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# External APIs
OPEN_DATA_PORTAL_API_KEY=
LEGAL_INFO_API_KEY=

# Feature Flags
ENABLE_PROMPT_CACHING=true
ENABLE_AUTO_TOPIC_DETECTION=true
ENABLE_MULTILINGUAL_SEARCH=true
